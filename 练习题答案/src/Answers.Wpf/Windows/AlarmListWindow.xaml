<Window x:Class="Answers.Wpf.Windows.AlarmListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第 05 章练习 5 · 报警排序筛选"
        Width="1320" Height="920" MinWidth="1120" MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="第 05 章练习 5 · 报警排序筛选" Style="{StaticResource PageTitle}"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="CollectionViewSource 在原始集合之上做筛选和排序；DataGrid 只显示视图，不改动源数据。" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="11,5">
                    <TextBlock Text="ICollectionView · DataGrid" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <Grid Width="320">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="设备 / 点位 / 描述…" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               FontSize="11.5" Foreground="{DynamicResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="1" Content="+ 新增模拟报警" Command="{Binding AddAlarmCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="级别" VerticalAlignment="Center" Margin="0,0,10,0"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding SeverityOptions}"
                                     SelectedItem="{Binding SelectedSeverity}"
                                     VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,10,0"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            <ListBox Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding SortOptions}"
                                     SelectedItem="{Binding SelectedSort}"
                                     VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Padding="18,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="报警记录" Style="{StaticResource SectionTitle}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="演示数据" Style="{StaticResource MutedText}" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="10,1,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding AlarmView}" Height="398">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="88"/>
                                <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="104"/>
                                <DataGridTextColumn Header="点位" Binding="{Binding Tag}" Width="104"/>
                                <DataGridTemplateColumn Header="级别" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource SeverityPillTemplate}"
                                                            HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="数值" Binding="{Binding Value, StringFormat={}{0:F2}}" Width="78">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="描述" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="确认" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AckText}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Acknowledged}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Padding="18,11" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="筛选条件作用于 ICollectionView，原集合 Alarms 不会被修改；点“新增模拟报警”可以观察 CountText 的变化。"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="实现要点" Style="{StaticResource SectionTitle}"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                       Text="AlarmView 来自 CollectionViewSource.GetDefaultView(Alarms)，是集合的“视图”；DataGrid 绑定它而不是 Alarms。"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                       Text="Filter 委托返回 true/false 控制显示；SortDescriptions 描述排序字段和方向。条件变化后调用 Refresh() 重新计算视图。"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                       Text="搜索同时匹配设备、点位和描述，并且和级别筛选叠加生效；清空搜索框即可恢复全部记录。"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}"
                   Margin="28,0,28,14"
                   Text="设计器提示：DataGrid 的列、模板列和绑定都在这个 XAML 里；运行后可在搜索框输入“水泵”或切换级别查看筛选效果。"/>
    </Grid>
</Window>
