<Window x:Class="Answers.Wpf.Windows.DeviceCardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selectors="clr-namespace:Answers.Wpf.Selectors"
        Title="第 05 章练习 3 · 设备卡片"
        Width="1340" Height="920" MinWidth="1120" MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 三种设备卡片模板：布局完全不同，由 DataTemplateSelector 按真实类型挑选 -->
        <DataTemplate x:Key="PlcTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DeviceCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="PLC" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PlcBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Location}" FontSize="10.5" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceStatusTemplate}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU 负载" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding CpuLoad, StringFormat={}{0:F1}%}" FontSize="19"
                                       FontWeight="SemiBold" Margin="0,3,0,0"
                                       Foreground="{DynamicResource PlcBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="扫描周期" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding ScanMs, StringFormat={}{0:F1} ms}" FontSize="19"
                                       FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MeterTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DeviceCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{DynamicResource InfoSoftBrush}">
                                <TextBlock Text="kWh" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MeterBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Location}" FontSize="10.5" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceStatusTemplate}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="线电压 Uab" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Voltage, StringFormat={}{0:F1}}" FontSize="27"
                                           FontWeight="SemiBold" Foreground="{DynamicResource MeterBrush}"/>
                                <TextBlock Text="V" VerticalAlignment="Bottom" Margin="4,0,0,4"
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="电流" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Current, StringFormat={}{0:F1} A}" HorizontalAlignment="Right"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="功率因数" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding PowerFactor, StringFormat={}{0:F2}}" HorizontalAlignment="Right"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InverterTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DeviceCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{DynamicResource WarnSoftBrush}">
                                <TextBlock Text="Hz" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource InverterBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding Location}" FontSize="10.5" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceStatusTemplate}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Frequency, StringFormat={}{0:F1}}" FontSize="27"
                                       FontWeight="SemiBold" Foreground="{DynamicResource InverterBrush}"/>
                            <TextBlock Text="Hz" VerticalAlignment="Bottom" Margin="4,0,0,4"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="9"
                                    Padding="9,3" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Direction}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InverterBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding MotorCurrent, StringFormat=电机 {0:F1} A}" FontSize="10.5"
                                       HorizontalAlignment="Right" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:DeviceTemplateSelector x:Key="DeviceSelector"
                                          PlcTemplate="{StaticResource PlcTemplate}"
                                          MeterTemplate="{StaticResource MeterTemplate}"
                                          InverterTemplate="{StaticResource InverterTemplate}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="第 05 章练习 3 · 设备卡片" Style="{StaticResource PageTitle}"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="同一组设备数据，PLC / 电表 / 变频器三种完全不同的卡片布局，由 DataTemplateSelector 自动挑选。" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="11,5">
                    <TextBlock Text="DataTemplateSelector" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="18">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="混合设备列表" Style="{StaticResource SectionTitle}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding OnlineText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource MonoText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Content="刷新模拟数据" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}"
                              ItemTemplateSelector="{StaticResource DeviceSelector}"
                              Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="DataTemplateSelector 的用法" Style="{StaticResource SectionTitle}"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                       Text="三种设备共用 ObservableCollection&lt;DeviceCardBase&gt;，ItemsControl 不需要知道具体类型。"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                       Text="DeviceTemplateSelector 根据 PlcCard / MeterCard / InverterCard 返回不同的 DataTemplate，卡片布局完全不同。"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                       Text="离线设备由 DataTrigger 统一降低透明度，状态胶囊也同步变为红色，不需要写转换器。"/>
                        </Grid>

                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
                            <TextBlock Text="&lt;ItemsControl ItemTemplateSelector=&quot;{StaticResource DeviceSelector}&quot; /&gt;"
                                       FontFamily="Consolas" FontSize="11.5"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}"
                   Margin="28,0,28,14"
                   Text="设计器提示：Window.Resources 里的三个 DataTemplate 会直接在设计器中渲染；改卡片布局不需要动任何 C# 代码。"/>
    </Grid>
</Window>
