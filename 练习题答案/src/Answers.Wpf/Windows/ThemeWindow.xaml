<Window x:Class="Answers.Wpf.Windows.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第 05 章练习 4 · 日夜主题"
        Width="1300" Height="900" MinWidth="1100" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="第 05 章练习 4 · 日夜主题" Style="{StaticResource PageTitle}"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="颜色抽到 Dark.xaml / Light.xaml，界面统一用 DynamicResource；运行时替换字典即可整窗换肤。" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="11,5">
                    <TextBlock Text="ResourceDictionary · 换肤" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="主题切换" Style="{StaticResource SectionTitle}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="运行时替换合并字典，所有 DynamicResource 立即换色"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="10,4">
                                    <TextBlock Text="{Binding CurrentThemeText}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="夜间主题" Command="{Binding UseDarkCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                                <Button Content="日间主题" Command="{Binding UseLightCommand}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button Content="切换一次" Command="{Binding ToggleCommand}"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="ToggleCommand：不指定主题，直接把当前主题取反"/>
                            </StackPanel>

                            <Border Background="{DynamicResource BgBrush}" CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="18" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="1# 炉膛温度" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="86.4" FontFamily="Segoe UI" FontSize="38"
                                                       FontWeight="Bold" Foreground="{DynamicResource AlarmBrush}"/>
                                            <TextBlock Text="℃" VerticalAlignment="Bottom" Margin="5,0,0,7"
                                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Background="{DynamicResource AlarmSoftBrush}" CornerRadius="9"
                                                    Padding="9,3" Margin="0,0,7,0">
                                                <TextBlock Text="温度高报警" FontSize="10"
                                                           Foreground="{DynamicResource AlarmBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                                                    Padding="9,3">
                                                <TextBlock Text="1# 加热炉" FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="联动操作" FontSize="10"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <Button Content="确认报警" Style="{StaticResource PrimaryButton}"
                                                        Padding="14,6" Margin="0,7,0,0" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="调色板" Style="{StaticResource SectionTitle}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="这些刷子全部来自 Themes/Dark.xaml 与 Themes/Light.xaml，键名完全一致。"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

                            <UniformGrid Columns="4" Margin="0,14,0,-10">
                                <StackPanel Margin="0,0,10,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource BgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <TextBlock Text="BgBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    <TextBlock Text="SurfaceBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="AccentBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource AlarmBrush}"/>
                                    <TextBlock Text="AlarmBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource WarnBrush}"/>
                                    <TextBlock Text="WarnBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource InfoBrush}"/>
                                    <TextBlock Text="InfoBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="TextBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <Border Height="46" CornerRadius="8" Background="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="MutedBrush" Style="{StaticResource MonoText}" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="换肤发生了什么" Style="{StaticResource SectionTitle}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="点击按钮后，ThemeManager 在 Application.Resources.MergedDictionaries 里找到旧的 Dark.xaml / Light.xaml，用新的字典原地替换。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>

                            <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="11.5" LineHeight="19"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Text="ThemeManager.Apply(ThemeMode.Light);&#10;&#10;// 1. 找到旧主题字典&#10;// 2. 用同键名的新字典替换&#10;// 3. DynamicResource 自动重取颜色"/>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="StaticResource 只在加载时取一次值；DynamicResource 保留的是“资源引用”，字典换了就会重新解析。"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="窗口、DataGrid 和自绘图表都用 DynamicResource；图表在构造函数里调用 SetResourceReference，把依赖属性绑到主题刷子。"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="切换不需要重建控件，所以输入框内容、DataGrid 滚动位置和选中行都会保留。"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="新增颜色时" Style="{StaticResource SectionTitle}" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Text="两个主题字典必须同时增加同名 Key；漏掉一个，切到那套主题时 DynamicResource 会找不到资源，控件回退为透明或默认色。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}"
                   Margin="28,0,28,14"
                   Text="设计器提示：切换主题后，主窗口和所有已打开窗口会一起变色；颜色键都在 Themes 文件夹的两本字典里。"/>
    </Grid>
</Window>
