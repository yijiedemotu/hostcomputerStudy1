<Window x:Class="Answers.Wpf.Windows.AlarmSoundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第 05 章练习 1 · 报警声音"
        Width="1280" Height="900" MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 窗口标题不是硬编码在系统标题栏里，而是用页面标题说明这道题在练什么 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="第 05 章练习 1 · 报警声音" Style="{StaticResource PageTitle}"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="温度连续超限才报警；声音由 View 播放，ViewModel 只负责状态和规则。" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="11,5">
                    <TextBlock Text="MVVM · DispatcherTimer" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Style="{StaticResource CardBorder}" Padding="26">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="1# 加热炉 · 实时温度" Style="{StaticResource SectionTitle}" FontSize="14"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Device-01 · Modbus TCP · 采集周期 1 s"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="10,4">
                                    <TextBlock Text="模拟数据源" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1}}"
                                               Style="{StaticResource KpiValue}" FontSize="68"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="℃" FontSize="22" Margin="8,0,0,20"
                                               VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="高高限阈值" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock Text="{Binding Threshold, StringFormat={}{0:F1} ℃}"
                                                   HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="活动报警" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock Text="{Binding ActiveAlarms, StringFormat={}{0} 条}"
                                                   HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="累计确认" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock Text="{Binding AcknowledgeCount, StringFormat={}{0} 次}"
                                                   HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" CornerRadius="10" Padding="14,11" Margin="0,20,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AlarmSoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource PlcBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AlarmBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding AlarmStatusText}" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AlarmBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="模拟温度报警" Command="{Binding TriggerAlarmCommand}"
                                        Style="{StaticResource AlarmButton}" Margin="0,0,10,0"/>
                                <Button Content="{Binding MuteButtonText}" Command="{Binding MuteCommand}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button Content="确认并复位" Command="{Binding AcknowledgeCommand}"
                                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasActiveAlarms}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="实现要点" Style="{StaticResource SectionTitle}"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="定时器放在 Window：DispatcherTimer 每秒调用 vm.Tick()，ViewModel 不引用 Dispatcher，也不碰控件。"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="声音也在窗口后台播放：只有在 HasActiveAlarms 且未静音时，每隔 4 秒调用一次 SystemSounds.Exclamation.Play()。"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="按钮全部走 ICommand；“确认并复位”的 IsEnabled 绑定 HasActiveAlarms，没有报警时自动变灰。"/>
                            </Grid>

                            <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
                                <TextBlock Text="SystemSounds.Exclamation.Play();   // 换 MediaPlayer 就能播自定义 wav"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="报警状态" Style="{StaticResource SectionTitle}"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="{Binding ActiveAlarms}" FontFamily="Segoe UI" FontSize="46"
                                           FontWeight="Bold" VerticalAlignment="Bottom">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AlarmBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="条活动报警" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Bottom" Margin="8,0,0,10"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SoundStateText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                            <Grid>
                                <TextBlock Text="最近报警记录" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="最多保留 30 条" HorizontalAlignment="Right"
                                           FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>

                            <ScrollViewer Height="248" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding RecentAlarms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="7"
                                                    Padding="10,7" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                                           LineHeight="17" Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="为什么声音不写在 ViewModel" Style="{StaticResource SectionTitle}" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Text="VM 负责“是否有报警、是否静音”这些状态；发声属于平台交互，放在窗口后台才能单独替换，也方便以后改成播报语音或写入报警日志。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}"
                   Margin="28,704,28,14"
                   Text="设计器提示：本窗口就是完整的练习界面；XAML 里的绑定在设计时显示为占位值，运行时由 AlarmSoundViewModel 提供数据。" Grid.RowSpan="2"/>
    </Grid>
</Window>
