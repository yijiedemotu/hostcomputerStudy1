<Window x:Class="ScadaDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScadaDashboard.Controls"
        Title="产线监控看板 · WPF MVVM Demo"
        Height="880" Width="1420" MinHeight="720" MinWidth="1120"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI">

    <!--
        整个窗口用 5 行 Grid 布局：
        0 标题/按钮（Auto）、1 KPI 卡片（Auto）、2 趋势图（* 占满剩余）、
        3 报警表（固定 200）、4 状态栏（Auto）。
        XAML 里的所有 {Binding ...} 都指向 MainWindow.DataContext（即 MainViewModel）。
    -->
    <Grid Margin="20,16,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题 + 操作按钮 ===== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="6" Height="34" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="产线监控看板" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="WPF · MVVM · Modbus TCP · 手写趋势图" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- StatusText 由 ViewModel 通知更新；按钮通过 Command 调用 ViewModel，不在后台代码里写点击事件 -->
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                <Button Content="▶ 启动采集" Command="{Binding StartCommand}" Style="{StaticResource ToolButton}"/>
                <Button Content="■ 停止" Command="{Binding StopCommand}" Style="{StaticResource ToolButton}"/>
            </StackPanel>
        </Grid>

        <!-- ===== KPI 卡片区 =====
             ListBox 的每一项是一个 TagViewModel，WrapPanel 让卡片自动换行。
             SelectedItem 双向绑定：点卡片 → ViewModel.SelectedTag 变化；
             ViewModel 改 SelectedTag → 卡片高亮也跟着变。 -->
        <ListBox Grid.Row="1" Margin="0,14,0,2"
                 ItemsSource="{Binding Tags}"
                 SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource TagCardStyle}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- ItemTemplate：一张卡片内部长什么样。所有 TextBlock 都绑定 TagViewModel 的属性。 -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="196">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="ValueText" Text="{Binding ValueText}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding Unit}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QualityText" Text="{Binding Quality}" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding Device}" Foreground="#5B6472" FontSize="11" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!--
                        DataTrigger：根据数据自动换样式，不用写任何 C# 代码。
                        IsAlarm = true → 数值/圆点/质量文字变红；
                        IsBad   = true → 变灰（通信故障，值不可信）。
                    -->
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AlarmBrush}"/>
                            <Setter TargetName="QualityText" Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBad}" Value="True">
                            <Setter TargetName="ValueText" Property="Foreground" Value="#6B7280"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#6B7280"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== 趋势图 =====
             TrendChartControl 是手写的 WPF 控件（OnRender 绘制）。
             它不绑 ViewModel，而是由 MainWindow.xaml.cs 在选中位号/收到新点时直接调用方法。 -->
        <Border Grid.Row="2" Margin="0,8,0,0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <controls:TrendChartControl x:Name="Trend" Margin="1"/>
        </Border>

        <!-- ===== 报警表 ===== -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="报警记录" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="（只在状态翻转时记录，恢复也算一条）" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="清空" Command="{Binding ClearAlarmsCommand}" Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Right" Margin="16,0,0,0" Padding="12,3"/>
                </StackPanel>

                <!-- 报警表：列在下面手工定义，每列绑定 AlarmViewModel 的一个属性 -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Alarms}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                          Background="Transparent" RowBackground="#171A21" AlternatingRowBackground="#1A1E26"
                          Foreground="{StaticResource TextBrush}" CanUserAddRows="False"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}" RowHeight="26" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="90"/>
                        <DataGridTextColumn Header="位号" Binding="{Binding TagName}" Width="*"/>
                        <DataGridTextColumn Header="数值" Binding="{Binding ValueText}" Width="110"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="110"/>
                        <DataGridTextColumn Header="动作" Binding="{Binding ActionText}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== 状态栏 ===== -->
        <Grid Grid.Row="4" Margin="2,8,2,0">
            <TextBlock Text="{Binding SampleCountText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <TextBlock Text="{Binding LastUpdateText, StringFormat=最后更新 {0}}" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" HorizontalAlignment="Center"/>
            <TextBlock Text="提示：本看板连 127.0.0.1:502 的模拟从站，先运行 tools/modbus_slave_sim.py"
                       Foreground="#4B5261" FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
