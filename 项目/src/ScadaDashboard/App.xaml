<Application x:Class="ScadaDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <!--
        应用程序级资源：这里定义的 Brush / Style 在所有窗口里都能用。
        颜色集中管理是换肤的基础：界面里只引用 key，不写死颜色。
    -->
    <Application.Resources>
        <!-- 工业深色主题：所有颜色集中在这里，换肤只改这一处 -->
        <SolidColorBrush x:Key="BgBrush" Color="#12141A"/>       <!-- 窗口背景 -->
        <SolidColorBrush x:Key="PanelBrush" Color="#171A21"/>    <!-- 卡片/面板背景 -->
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3A"/>   <!-- 边框 -->
        <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC"/>     <!-- 主文字 -->
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>    <!-- 次要文字 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#00DCA0"/>   <!-- 强调色/正常状态 -->
        <SolidColorBrush x:Key="AlarmBrush" Color="#FF6B6B"/>    <!-- 报警红 -->

        <!--
            工具栏按钮样式。
            x:Key 是“样式名字”，界面里用 Style="{StaticResource ToolButton}" 引用。
            ControlTemplate 决定按钮长什么样；Trigger 在鼠标悬停/禁用时自动换效果。
        -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#222833"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#333B4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- TemplateBinding：把控件自身的属性值绑定到模板里 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标移入：背景变亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3442"/>
                            </Trigger>
                            <!-- 按钮禁用：整体半透明 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI 卡片：选中时高亮边框。ListBoxItem 就是每个卡片的外壳。 -->
        <Style x:Key="TagCardStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 被选中：绿色边框 + 稍亮的背景 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1B2029"/>
                            </Trigger>
                            <!-- 鼠标悬停：边框变亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4453"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格列头样式 -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E232C"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
