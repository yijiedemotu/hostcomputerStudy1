<Window x:Class="Exercises.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Exercises.Wpf.ViewModels"
        xmlns:views="clr-namespace:Exercises.Wpf.Views"
        Title="上位机学习 · 第 05 章 WPF 练习"
        Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AlarmSoundViewModel}">
            <views:AlarmSoundView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CrosshairViewModel}">
            <views:CrosshairView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceCardsViewModel}">
            <views:DeviceCardsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThemeViewModel}">
            <views:ThemeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmListViewModel}">
            <views:AlarmListView/>
        </DataTemplate>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Num" Text="{Binding Number}" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" BasedOn="{StaticResource CaptionButton}" TargetType="Button"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：CaptionHeight 把整条设为可拖动区域，按钮单独放行 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="264"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="工" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="上位机练习" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="第 05 章 · WPF 与 MVVM · 练习答案"
                           VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}"
                            Content="—" Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                            Content="□" Click="Maximize_Click" ToolTip="最大化 / 还原" Margin="2,0"/>
                    <Button Style="{StaticResource CloseCaptionButton}"
                            Content="×" Click="Close_Click" ToolTip="关闭" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="练习目录" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="24,20,0,8"/>
                        <ListBox ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="10,0,10,0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="18,12,18,18" Padding="14"
                            Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="三个可运行项目" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                       Text="Console · WinForms · WPF&#10;同一套答案，按章节运行。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="32,24,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding SelectedSection.Description}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Left" MaxWidth="720" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,2,0,0">
                        <Button Content="{Binding Theme.ToggleText}" Command="{Binding Theme.ToggleCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Theme.CurrentThemeText}" Style="{StaticResource MonoText}"
                                   HorizontalAlignment="Right" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                    <ContentControl Content="{Binding SelectedSection.Content}" Margin="0,0,6,24"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
